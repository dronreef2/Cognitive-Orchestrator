# Cognitive Orchestrator - Environment Variables
# Copy this file to .env and add your API keys

# OpenAI API Key (for GPT-4, GPT-3.5, etc.)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini API Key (alternative to OpenAI)
# Get your key from: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# Note: You only need one of the above API keys.
# The system will use OpenAI by default if both are present.
